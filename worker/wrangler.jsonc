{
  // GanttChart shared workspace: Worker + Durable Object (SQLite) + static SPA.
  // Nothing here creates or changes anything in your Cloudflare account until
  // `wrangler deploy` is run — see docs/CLOUD_ARCHITECTURE.md §10.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganttchart",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],

  // The production workers.dev hostname (ganttchart.<your-subdomain>.workers.dev)
  // IS the application URL; no custom domain is purchased. It must be covered
  // by a hostname-based Cloudflare Access application BEFORE the first deploy
  // (docs/DEPLOYMENT_PLAN.md). Preview / version URLs stay OFF so there is no
  // second, unprotected hostname for the same Worker.
  "workers_dev": true,
  "preview_urls": false,

  // The built SPA (`npm run build` in the repo root → ../dist).
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },

  // WORKSPACE: one instance PER TENANT (addressed by tenant id) = the data plane.
  // REGISTRY:  one instance = the control plane (tenants, users, roles, deletion audit).
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceRoom" },
      { "name": "REGISTRY", "class_name": "RegistryRoom" }
    ]
  },
  // v1 is the Stage 4 class (unchanged storage schema); v2 only ADDS the registry.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryRoom"] }
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Production values are set at deploy time (never commit real team/AUD values
  // if you prefer to keep them private). While empty the Worker FAILS CLOSED
  // (HTTP 500 on every API/WebSocket request).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "SUPER_ADMIN_EMAILS": "",
    "HISTORY_RETENTION_DAYS": "30"
  },

  "env": {
    // `wrangler dev --env dev`: local identity, no Access. Loopback hosts only.
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "DEV_EMAIL": "super@dev.test",
        "SUPER_ADMIN_EMAILS": "super@dev.test",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:8787",
        "HISTORY_RETENTION_DAYS": "30"
      },
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceRoom" },
          { "name": "REGISTRY", "class_name": "RegistryRoom" }
        ]
      },
      "assets": {
        "directory": "../dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/ws"]
      }
    }
  }
}
