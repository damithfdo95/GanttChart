{
  "name": "ganttchart-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared-workspace backend for GanttChart: Worker + Durable Object (SQLite) behind Cloudflare Access.",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/workers/tsconfig.json",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "test:core": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "validate": "wrangler types && wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dryrun"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "~5.6.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
